  "scripts": {
    "dev": "ts-node-dev --require tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:schema": "ts-node-dev --require tsconfig-paths/register --transpile-only src/scripts/database/schema.ts",
    "db:schema-fresh": "ts-node-dev --require tsconfig-paths/register --transpile-only src/scripts/database/schema.ts -- --fresh",
    "db:seed": "ts-node-dev --require tsconfig-paths/register --transpile-only src/scripts/database/seed.ts",
    "db:import-hospitals": "ts-node-dev --require tsconfig-paths/register --transpile-only src/scripts/database/import-hospitals.ts",
    "db:import-seaman": "ts-node-dev --require tsconfig-paths/register --transpile-only src/scripts/database/import-seaman.ts",
    "db:import-kapal": "ts-node-dev --require tsconfig-paths/register --transpile-only src/scripts/database/import-kapal.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
