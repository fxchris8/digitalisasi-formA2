# ══════════════════════════════════════════════════════════════
#  Production Environment Template
#
#  Cara pakai di VPS/VM:
#    cp .env.docker .env
#    nano .env  (isi semua nilai di bawah ini)
#    docker compose up -d --build
# ══════════════════════════════════════════════════════════════


# Domain 
# Skenario 1 — same domain, path-based (paling umum):
#   FRONTEND_DOMAIN=yourdomain.com
#   BACKEND_DOMAIN=yourdomain.com
#   VITE_API_URL=   (kosong, FE pakai /api/... ke origin yang sama)
#
# Skenario 2 — subdomain terpisah:
#   FRONTEND_DOMAIN=app.yourdomain.com
#   BACKEND_DOMAIN=api.yourdomain.com
#   VITE_API_URL=https://api.yourdomain.com
#
# Skenario 3 — IP/server berbeda (BE tidak pakai Traefik):
#   FRONTEND_DOMAIN=app.yourdomain.com
#   BACKEND_DOMAIN= (kosong atau hapus label Traefik backend)
#   VITE_API_URL=http://192.168.1.100:18293
FRONTEND_DOMAIN=yourdomain.com
BACKEND_DOMAIN=yourdomain.com


# Port (sisi host, bukan port internal container)
FRONTEND_PORT=8099
BACKEND_PORT=18293


# Traefik
# Sesuaikan dengan konfigurasi Traefik yang ada di VPS
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt


# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname


# CORS
# URL persis tempat frontend diakses dari browser
CORS_ORIGIN=https://yourdomain.com


# JWT
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d


# Frontend API URL
# Lihat komentar di bagian Domain di atas untuk panduan pengisian.
VITE_API_URL=
